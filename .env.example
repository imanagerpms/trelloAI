# Ottieni API Key e Token da https://trello.com/power-ups/admin
# (trello.com/app-key reindirizza al portale Power-Up)
TRELLO_API_KEY=your_api_key_here
TRELLO_TOKEN=your_token_here

# Opzionale: ID board predefinita (lo trovi nell'URL: trello.com/b/SHORTLINK/BOARD_ID)
TRELLO_DEFAULT_BOARD_ID=

# Board Manutenzioni (override opzionale — default anche in config/boards.json)
TRELLO_MANUTENZIONI_BOARD_ID=
TRELLO_MANUTENTORE_ID=

# Board Gestione & Amministrazione
TRELLO_GESTIONE_BOARD_ID=
TRELLO_AMMINISTRAZIONE_BOARD_ID=
TRELLO_DANIELE_ID=
TRELLO_MERI_ID=

# Telegram — Super Manager
TELEGRAM_BOT_TOKEN=
# Chat autorizzate (id numerici). Vuoto = accetta tutti
TELEGRAM_ALLOWED_CHAT_IDS=

# UI Admin (https://…sslip.io/admin/) — obbligatorio in produzione
ADMIN_TOKEN=

# LLM obbligatorio per linguaggio naturale (una delle due)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Octorate MCP (Settings › Advanced › API in Octorate)
OCTORATE_MCP_URL=https://mcp.octorate.com/mcp
OCTORATE_MCP_PUBLIC=
OCTORATE_MCP_SECRET=
# Su Scaleway (ship): PUBLIC_BASE_URL=https://IP-con-trattini.sslip.io
# PUBLIC_HTTP_PORT=8787
# OCTORATE_OAUTH_REDIRECT_URI=https://IP-con-trattini.sslip.io/oauth/callback
# Oppure dopo login: OCTORATE_MCP_ACCESS_TOKEN=

# AIBridge (futuro — chat clienti)
# AIBRIDGE_API_URL=
# AIBRIDGE_API_KEY=
